<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal ITM - Inicio</title>
    <!-- Importamos una fuente profesional de Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        /* Estilos Globales */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #eef2f9; /* Azul muy claro de fondo */
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: #333;
        }

        /* Tarjeta Principal */
        .card {
            background-color: #ffffff;
            padding: 50px 40px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 51, 102, 0.1); /* Sombra azulada suave */
            text-align: center;
            max-width: 450px;
            width: 100%;
            border-top: 5px solid #003366; /* Detalle superior institucional */
        }

        h1 {
            color: #003366; /* Azul oscuro corporativo */
            font-weight: 600;
            margin-bottom: 10px;
            font-size: 24px;
        }

        p {
            color: #666;
            font-size: 15px;
            margin-bottom: 30px;
        }

        /* Foto de Perfil */
        .profile-pic {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #e0e7ff;
            margin-bottom: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        /* Botones */
        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 20px;
        }

        .btn {
            padding: 14px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 16px;
            transition: all 0.3s ease;
            display: block;
            box-sizing: border-box;
        }

        /* Colores de Botones */
        .btn-login {
            background-color: #0056b3; /* Azul brillante */
            color: white;
            border: 2px solid #0056b3;
        }
        .btn-login:hover {
            background-color: #004494;
        }

        .btn-signup {
            background-color: transparent;
            color: #0056b3;
            border: 2px solid #0056b3;
        }
        .btn-signup:hover {
            background-color: #f0f6ff;
        }

        .btn-edit {
            background-color: #17a2b8; /* Azul turquesa para editar */
            color: white;
            border: 2px solid #17a2b8;
            margin-bottom: 10px;
        }
        .btn-edit:hover {
            background-color: #138496;
        }

        .btn-logout {
            background-color: transparent;
            color: #dc3545;
            border: 2px solid #dc3545;
        }
        .btn-logout:hover {
            background-color: #fdf2f2;
        }
    </style>
</head>
<body>

    <div class="card">
        <% if (user) { %>
            <!-- SECCIÓN: Usuario Logueado -->
            <img src="<%= user.picture %>" alt="Foto de perfil" class="profile-pic">
            <h1>Bienvenido(a)</h1>
            <p><strong><%= user.name %></strong><br><%= user.email %></p>
            
            <div class="btn-group">
                <a href="/perfil" class="btn btn-edit">Modificar mis datos personales</a>
                <a href="/logout" class="btn btn-logout">Cerrar Sesión</a>
            </div>

        <% } else { %>
            <!-- SECCIÓN: Usuario NO Logueado -->
            <h1>Portal de Estudiantes</h1>
            <p>Institución Universitaria ITM<br>Por favor, ingresa al sistema para continuar.</p>
            
            <div class="btn-group">
                <a href="/login" class="btn btn-login">Iniciar Sesión</a>
                <a href="/signup" class="btn btn-signup">Crear una cuenta nueva</a>
            </div>
        <% } %>
    </div>

</body>
</html>